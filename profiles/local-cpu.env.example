# Low-memory CPU profile. Run the local model server separately.
# No Hugging Face API token or cloud inference is used by this provider.
DEEPSCHOLAR_OFFLINE=false
DEEPSCHOLAR_LLM_PROVIDER=local
DEEPSCHOLAR_LLM_MODEL=deepscholar-qwen-local
DEEPSCHOLAR_LLM_BASE_URL=http://127.0.0.1:8080/v1
DEEPSCHOLAR_MAX_PAPERS=3
DEEPSCHOLAR_MAX_OUTPUT_TOKENS=350
DEEPSCHOLAR_EVIDENCE_LIMIT=3
DEEPSCHOLAR_CHUNK_CHARS=800
DEEPSCHOLAR_CHUNK_OVERLAP=100
DEEPSCHOLAR_LLM_TIMEOUT=300
DEEPSCHOLAR_WORKFLOW_TIMEOUT=400
