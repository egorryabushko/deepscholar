# Default demo is offline and does not use a model or token.
DEEPSCHOLAR_OFFLINE=true
DEEPSCHOLAR_LLM_PROVIDER=extractive
DEEPSCHOLAR_MAX_PAPERS=6

# Live search: set OFFLINE=false. Basic OpenAlex requests may work without a key.
# DEEPSCHOLAR_OPENALEX_API_KEY=

# Hugging Face: choose an available model/provider, then set LLM_PROVIDER=huggingface.
DEEPSCHOLAR_HF_MODEL=Qwen/Qwen2.5-7B-Instruct
DEEPSCHOLAR_HF_PROVIDER=auto
# DEEPSCHOLAR_HF_TOKEN=

# Local open-weight model: set LLM_PROVIDER=local and the model's served name above.
DEEPSCHOLAR_LLM_BASE_URL=http://localhost:11434/v1
# DEEPSCHOLAR_LLM_API_KEY=
# DEEPSCHOLAR_LLM_MODEL=qwen2.5:1.5b
# DEEPSCHOLAR_MAX_OUTPUT_TOKENS=350
# DEEPSCHOLAR_EVIDENCE_LIMIT=3
# DEEPSCHOLAR_LLM_TIMEOUT=300
# DEEPSCHOLAR_WORKFLOW_TIMEOUT=400

# Exact trusted HTTPS hosts for PDFs; other PDFs fall back to labeled abstracts.
DEEPSCHOLAR_PDF_HOSTS=["arxiv.org","export.arxiv.org"]
